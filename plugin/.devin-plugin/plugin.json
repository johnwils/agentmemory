{
  "name": "agentmemory",
  "version": "0.9.29",
  "description": "Persistent memory for AI coding agents. Captures sessions, recalls with hybrid BM25 + vector + graph search, and exposes 54 memory tools over MCP. Keyless by default, runs on your machine.",
  "author": {
    "name": "John Wilson",
    "url": "https://github.com/johnwils"
  },
  "homepage": "https://github.com/johnwils/agentmemory",
  "repository": "https://github.com/johnwils/agentmemory",
  "license": "Apache-2.0",
  "keywords": [
    "memory",
    "mcp",
    "recall",
    "knowledge-graph",
    "agent-memory"
  ],
  "mcpServers": {
    "agentmemory": {
      "command": "npx",
      "args": [
        "-y",
        "@agentmemory/mcp"
      ],
      "env": {
        "AGENTMEMORY_URL": "${AGENTMEMORY_URL:-http://localhost:3111}",
        "AGENTMEMORY_SECRET": "${AGENTMEMORY_SECRET:-}"
      }
    }
  }
}